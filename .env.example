# Copy to .env and adjust. GEMINI_API_KEY is the only required value.

# --- Gemini (required) ----------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Chunking -------------------------------------------------------------
# Target chunk length. Audio shorter than CHUNK_SIZE_SEC + CHUNK_SEARCH_WINDOW_SEC
# is sent to Gemini whole, with no VAD pass at all.
CHUNK_SIZE_SEC=120
# How far either side of the target we hunt for a silence to cut in.
CHUNK_SEARCH_WINDOW_SEC=30
MIN_SILENCE_SEC=0.25

# --- Concurrency and retries ---------------------------------------------
# Ceiling on chunks in flight to Gemini at once, per request.
MAX_PARALLEL_CHUNKS=4
MAX_RETRIES=3
REQUEST_TIMEOUT_SEC=180

# --- Limits ---------------------------------------------------------------
MAX_UPLOAD_BYTES=104857600

# --- Silero VAD -----------------------------------------------------------
# The Docker image bakes a model in at /opt/models. Leave blank outside
# Docker and it is downloaded to VAD_MODEL_CACHE_DIR once.
VAD_MODEL_PATH=
VAD_MODEL_CACHE_DIR=/tmp/silero-vad

# --- Misc -----------------------------------------------------------------
LOG_LEVEL=INFO
